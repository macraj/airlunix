#!/usr/bin/python3
"""Transient boot adapter: drain finite OpenRC output without a growing file."""
import os
import select
import subprocess
import sys
from pathlib import Path
from airlunix.logging_ram import emit, sanitize

level=sys.argv[1] if len(sys.argv)==2 else ''
if level not in ('sysinit','boot','default','shutdown'):raise SystemExit(2)
proc=subprocess.Popen(['/sbin/openrc',level],stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
os.set_blocking(proc.stdout.fileno(),False)
pending=bytearray();early=Path('/run/airlunix-log/early.log')
while True:
    ready,_,_=select.select([proc.stdout],[],[],.1)
    if ready:
        try:chunk=os.read(proc.stdout.fileno(),4096)
        except BlockingIOError:chunk=None
        if chunk:
            pending.extend(chunk)
            while b'\n' in pending or len(pending)>=1024:
                if b'\n' in pending:line,_,rest=pending.partition(b'\n');pending=bytearray(rest)
                else:line=bytes(pending[:1024]);del pending[:1024]
                text=sanitize(line.decode(errors='replace'))
                emit('service','openrc_output',message=text)
                try:
                    fd=os.open('/dev/console',os.O_WRONLY|os.O_NONBLOCK)
                    os.write(fd,(text+'\n').encode());os.close(fd)
                except OSError:pass
        elif chunk==b'' and proc.poll() is not None:break
    if proc.poll() is not None and not ready:break
emit('service','runlevel_'+level,proc.returncode==0)
raise SystemExit(proc.wait())
